# ==============================================================================
# Vendrite — environment configuration TEMPLATE
# ==============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
#   cp .env.example .env
#
# NOTHING in this file is a real secret. Never commit a populated `.env`.
# In CI, these same keys are provided via GitHub Actions Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL connection — shared host/port/database
# ------------------------------------------------------------------------------
# Local PostgreSQL (development default):
VENDRITE_DB_HOST=localhost
VENDRITE_DB_PORT=5432
VENDRITE_DB_NAME=vendrite

# Cloud Postgres (e.g. Neon) — placeholders only, get the real endpoint from the
# provider's console. Neon requires TLS, so set VENDRITE_DB_SSLMODE=require.
# Use the *direct* (non-pooled) endpoint for schema DDL + ETL; the pooled
# endpoint (host contains "-pooler") is fine for the read-only dashboard.
#   VENDRITE_DB_HOST=ep-example-name-a1b2c3d4.us-east-2.aws.neon.tech
#   VENDRITE_DB_PORT=5432
#   VENDRITE_DB_NAME=vendrite
#
# TLS mode passed to libpq. Leave blank for local (no TLS); "require" for Neon.
# Optionally "verify-full" plus a CA bundle path in VENDRITE_DB_SSLROOTCERT.
# VENDRITE_DB_CHANNEL_BINDING matches the "channel_binding=require" that Neon
# puts in its copy-paste connection string; leave blank for local.
VENDRITE_DB_SSLMODE=
VENDRITE_DB_SSLROOTCERT=
VENDRITE_DB_CHANNEL_BINDING=

# ------------------------------------------------------------------------------
# Two separate DB roles (see sql/schema/02_roles.sql)
#   - ETL role:       write access to staging + analytics
#   - Dashboard role: read-only access to analytics ONLY
# ------------------------------------------------------------------------------
VENDRITE_ETL_DB_USER=vendrite_etl
VENDRITE_ETL_DB_PASSWORD=change-me-etl

VENDRITE_DASHBOARD_DB_USER=vendrite_dashboard
VENDRITE_DASHBOARD_DB_PASSWORD=change-me-dashboard

# ------------------------------------------------------------------------------
# Mock data generator (Phase 1)
# ------------------------------------------------------------------------------
VENDRITE_MOCK_SEED=42
VENDRITE_MOCK_N_CUSTOMERS=250
VENDRITE_MOCK_N_PRODUCTS=50
VENDRITE_MOCK_N_ORDERS=9000
VENDRITE_MOCK_MONTHS_BACK=12

# ------------------------------------------------------------------------------
# Forecasting (Phase 2 linear regression + Phase B Holt-Winters)
# ------------------------------------------------------------------------------
VENDRITE_FORECAST_MODEL_VERSION=linreg-v1
VENDRITE_FORECAST_HW_MODEL_VERSION=holtwinters-v1
VENDRITE_FORECAST_SEASONAL_PERIODS=7
VENDRITE_FORECAST_HORIZON_DAYS=30

# ------------------------------------------------------------------------------
# Customer Lifetime Value (revamp Phase A) -- all are documented assumptions;
# see analytics/clv.py for the formula they feed.
# ------------------------------------------------------------------------------
VENDRITE_CLV_METHOD_VERSION=clv-heuristic-v1
VENDRITE_CLV_GROSS_MARGIN=0.30
VENDRITE_CLV_CHURN_DAYS=90
VENDRITE_CLV_MIN_TENURE_DAYS=30
VENDRITE_CLV_LIFESPAN_MIN_YEARS=1.0
VENDRITE_CLV_LIFESPAN_MAX_YEARS=10.0

# ------------------------------------------------------------------------------
# Cohort retention (revamp Phase A)
# ------------------------------------------------------------------------------
VENDRITE_COHORT_MAX_MONTHS=12
VENDRITE_COHORT_SIGNUP_GRACE_MONTHS=1

# ------------------------------------------------------------------------------
# Dashboard auth (Phase 5) — streamlit-authenticator
# Credentials are read from these env vars, never hardcoded.
# VENDRITE_AUTH_COOKIE_KEY must be a long random string.
# Generate the values below:
#   cookie key : python -c "import secrets; print(secrets.token_hex(32))"
#   pw hash    : python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass('pw: ').encode(), bcrypt.gensalt()).decode())"
# Only the bcrypt HASH is stored here -- never the plaintext password.
# ------------------------------------------------------------------------------
VENDRITE_AUTH_COOKIE_NAME=vendrite_auth
VENDRITE_AUTH_COOKIE_KEY=change-me-to-a-long-random-string
VENDRITE_AUTH_COOKIE_EXPIRY_DAYS=7
VENDRITE_AUTH_USERNAME=analyst
VENDRITE_AUTH_NAME=Vendrite Analyst
VENDRITE_AUTH_EMAIL=analyst@example.com
VENDRITE_AUTH_PASSWORD_HASH=$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH
